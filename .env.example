# Envoy local configuration template.
# This file contains no model key, browser cookie, or private credential.
# Copy to .env for Docker or local development. Never commit .env.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8140

# Optional overrides for local startup.
MYSQL_ROOT_PASSWORD=change-me-for-shared-or-production-use
MYSQL_PORT=3307
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-for-shared-or-production-use
MINIO_BUCKET=envoy
BACKEND_PORT=8140
FRONTEND_PORT=8200

# Use "local" when MinIO is not running; use "minio" for object storage.
ENVOY_STORAGE_MODE=minio
ENVOY_LOCAL_STORAGE_DIR=./tmp/storage

# Optional local LLM assistance through Ollama.
# Leave OLLAMA_MODEL empty to disable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SEC=120

# Optional Hermes-compatible multimodal API.
# Leave empty. Configure the model later from the Envoy settings panel.
# The key is encrypted locally and is never committed or returned to the frontend.
HERMES_VISION_BASE_URL=
HERMES_VISION_TOKEN=
HERMES_VISION_MODEL=deepseek-v4.1flash
HERMES_VISION_PROTOCOL=chat
HERMES_VISION_TIMEOUT_SEC=180
HERMES_VISION_MAX_IMAGES=6

# Safety timeout for ffmpeg and other media extraction commands.
MEDIA_COMMAND_TIMEOUT_SEC=300
