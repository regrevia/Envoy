# Envoy local configuration template.
# This file contains no model key, browser cookie, or private credential.
# Copy to .env for Docker or local development. Never commit .env.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8140

# Optional overrides for local startup.
MYSQL_ROOT_PASSWORD=change-me-for-shared-or-production-use
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-for-shared-or-production-use
MINIO_BUCKET=envoy
BACKEND_PORT=8140
FRONTEND_PORT=8200

# "local" keeps uploads on the envoy_runtime volume. "minio" needs the optional
# object-storage profile: docker compose --profile object-storage up -d
ENVOY_STORAGE_MODE=local
ENVOY_LOCAL_STORAGE_DIR=./tmp/storage
ENVOY_LOCAL_TASK_MAX_CONCURRENCY=2

# Optional local LLM assistance through Ollama.
# Leave OLLAMA_MODEL empty to disable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SEC=120

# Optional Hermes-compatible multimodal API.
# Leave empty. Configure the model later from the Envoy settings panel.
# The key is encrypted locally and is never committed or returned to the frontend.
HERMES_VISION_BASE_URL=
HERMES_VISION_TOKEN=
HERMES_VISION_MODEL=deepseek-v4.1flash
HERMES_VISION_PROTOCOL=chat
HERMES_VISION_TIMEOUT_SEC=180
HERMES_VISION_MAX_IMAGES=6

# Safety timeout for ffmpeg and other media extraction commands.
MEDIA_COMMAND_TIMEOUT_SEC=300

# Base images for the Docker build. Override when Docker Hub is unreachable,
# e.g. ENVOY_BACKEND_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
ENVOY_BACKEND_BASE_IMAGE=python:3.11-slim
ENVOY_FRONTEND_BASE_IMAGE=node:20-alpine
# Package mirrors for the backend build (China network).
# Containers ignore host proxies: set the mirror here. Measured on arm64:
# tuna 6.5-11.6 MB/s vs aliyun 0.28 MB/s for the same pip layer.
# ENVOY_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# ENVOY_PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# ENVOY_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# 1 installs whisper + paddleocr; 0 keeps the lean image (measured on arm64: 4.64 GB vs 1.9 GB).
# The whisper weights (~0.5 GB) download on first use into the envoy_runtime volume, not the image.
ENVOY_WITH_MEDIA=1
# Task execution: "local" runs tasks in the API process (default). "celery" sends them
# to the worker service, which you enable with `docker compose --profile worker up -d`.
ENVOY_TASK_EXECUTION_MODE=local
ENVOY_CELERY_CONCURRENCY=2
# ASR defaults: MEDIA_WHISPER_MODEL=small (~461 MB, CPU) and MEDIA_WHISPER_LANGUAGE=zh.
# Weights live in WHISPER_DOWNLOAD_ROOT (/app/tmp/whisper on the runtime volume), so a
# rebuilt container reuses them instead of downloading again.
