{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envoy.dev/schemas/envoy.knowledge-unit/1",
  "title": "Envoy Knowledge Unit v1",
  "description": "A claim with its sources, conditions and limits. See docs/architecture/knowledge-units-v1.md.",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "version",
    "status",
    "type",
    "title",
    "summary",
    "conditions",
    "steps",
    "limitations",
    "source_refs",
    "tests",
    "relations",
    "verified_at",
    "verified_against",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "envoy.knowledge-unit/1"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^ku-[a-f0-9]{16}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "promoted",
        "archived"
      ]
    },
    "type": {
      "enum": [
        "principle",
        "procedure",
        "method",
        "example",
        "counterexample",
        "condition"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "material_id",
          "evidence_id",
          "locator"
        ],
        "additionalProperties": false,
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^mat-[a-f0-9]{24}$"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^ev-[a-f0-9]{16}$"
          },
          "locator": {
            "oneOf": [
              {
                "title": "Locator",
                "description": "A place in the source medium, kept in that medium's own coordinates.",
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "web",
                      "pdf_page",
                      "video_time",
                      "audio_time",
                      "image_region",
                      "office_location"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "positive",
              "near_miss",
              "negative",
              "boundary"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "unit_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "supports",
              "contradicts",
              "extends",
              "depends_on"
            ]
          },
          "unit_id": {
            "type": "string",
            "pattern": "^ku-[a-f0-9]{16}$"
          }
        }
      }
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_against": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "at",
          "change",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
