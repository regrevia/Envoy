{
  "name": "envoy-dsh",
  "version": "0.1.63",
  "description": "蒸馏一切链接：抖音/B 站视频、图文笔记、公众号文章、小红书、PDF、播客，一个链接蒸馏出摘要、Markdown、Wiki 或知识库交给宿主 AI 组装。视频按时序抽关键帧并配 ASR 转写，材料带来源定位可引用。60 轮对照：正常读完 22% -> 92%，跑到超时 68% -> 0%（探索性 A/B，未做人工正确性复核）。123 条真实链接 80% 能当素材。Codex、Claude Code、DSH。",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./index.js",
  "scripts": {
    "test": "node --test index.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "launch.cjs",
    "link-verdicts.json",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "envoy",
    "mcp",
    "multimodal",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/Envoy.git",
    "directory": "integrations/dsh/envoy-dsh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "homepage": "https://github.com/regrevia/Envoy/tree/main/integrations/dsh/envoy-dsh#readme",
  "bugs": {
    "url": "https://github.com/regrevia/Envoy/issues"
  }
}
