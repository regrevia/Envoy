{
  "name": "envoy-dsh",
  "version": "0.1.35",
  "description": "Paste a link; the agent reads it. Xiaohongshu, Douyin, Bilibili, WeChat, articles, PDFs and audio become citable Markdown for a wiki or knowledge base. On 60 turns with vs without: finishes reading 22% -> 92% (+70 points), times out 68% -> 0%, answer quotes a real source fact 23% -> 82% (the A/B is exploratory: different time caps, no human correctness review). On 123 live links 80% came back usable (93% of the pages that answered); an unreachable link reports in 26 s. Codex, Claude Code, DSH.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./index.js",
  "scripts": {
    "test": "node --test index.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "launch.cjs",
    "link-verdicts.json",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "envoy",
    "mcp",
    "multimodal",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/Envoy.git",
    "directory": "integrations/dsh/envoy-dsh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "homepage": "https://github.com/regrevia/Envoy/tree/main/integrations/dsh/envoy-dsh#readme",
  "bugs": {
    "url": "https://github.com/regrevia/Envoy/issues"
  }
}
